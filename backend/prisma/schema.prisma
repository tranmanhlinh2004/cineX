generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
  users           User[]

  @@map("roles")
}

model Permission {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int
  permissionId Int
  createdAt    DateTime   @default(now())
  id           Int        @id @default(autoincrement())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id                     Int             @id @default(autoincrement())
  roleId                 Int
  fullName               String
  email                  String          @unique
  phone                  String?
  password               String
  avatar                 String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  isActive               Boolean         @default(true)
  auditLogs              AuditLog[]
  bookings               Booking[]
  notifications          Notification[]
  refundRequests         RefundRequest[] @relation("RefundRequestUser")
  reviewedRefundRequests RefundRequest[] @relation("RefundRequestReviewer")
  refreshTokens          RefreshToken[]
  reviews                Review[]
  role                   Role            @relation(fields: [roleId], references: [id])

  @@map("users")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Movie {
  id          Int          @id @default(autoincrement())
  title       String
  slug        String       @unique
  description String?
  director    String?
  actors      String?
  duration    Int
  releaseDate DateTime?
  endDate     DateTime?
  language    String?
  country     String?
  ageLimit    String?
  trailerUrl  String?
  posterUrl   String?
  bannerUrl   String?
  status      MovieStatus  @default(COMING_SOON)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  movieGenres MovieGenre[]
  movieImages MovieImage[]
  reviews     Review[]
  showtimes   Showtime[]

  @@map("movies")
}

model Genre {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  movieGenres MovieGenre[]

  @@map("genres")
}

model MovieGenre {
  id      Int   @id @default(autoincrement())
  movieId Int
  genreId Int
  genre   Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)
  movie   Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([movieId, genreId])
  @@map("movie_genres")
}

model MovieImage {
  id        Int      @id @default(autoincrement())
  movieId   Int
  imageUrl  String
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@map("movie_images")
}

model Cinema {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  address     String
  city        String
  district    String?
  ward        String?
  phone       String?
  email       String?
  description String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  rooms       Room[]

  @@map("cinemas")
}

model Room {
  id           Int        @id @default(autoincrement())
  cinemaId     Int
  name         String
  totalRows    Int
  totalColumns Int
  totalSeats   Int
  status       RoomStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  cinema       Cinema     @relation(fields: [cinemaId], references: [id], onDelete: Cascade)
  seats        Seat[]
  showtimes    Showtime[]

  @@unique([cinemaId, name])
  @@map("rooms")
}

model SeatType {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  priceExtra  Decimal  @default(0) @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  seats       Seat[]

  @@map("seat_types")
}

model Seat {
  id             Int             @id @default(autoincrement())
  roomId         Int
  seatTypeId     Int
  rowName        String
  seatNumber     Int
  seatCode       String
  status         SeatStatus      @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  bookingDetails BookingDetail[]
  seatHolds      SeatHold[]
  room           Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  seatType       SeatType        @relation(fields: [seatTypeId], references: [id])
  showtimePrices ShowtimePrice[]
  tickets        Ticket[]

  @@unique([roomId, seatCode])
  @@unique([roomId, rowName, seatNumber])
  @@map("seats")
}

model Showtime {
  id             Int             @id @default(autoincrement())
  movieId        Int
  roomId         Int
  startTime      DateTime
  endTime        DateTime
  basePrice      Decimal         @db.Decimal(12, 2)
  status         ShowtimeStatus  @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  bookingDetails BookingDetail[]
  seatHolds      SeatHold[]
  showtimePrices ShowtimePrice[]
  movie          Movie           @relation(fields: [movieId], references: [id], onDelete: Cascade)
  room           Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  tickets        Ticket[]

  @@map("showtimes")
}

model ShowtimePrice {
  id         Int      @id @default(autoincrement())
  showtimeId Int
  seatId     Int
  price      Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  seat       Seat     @relation(fields: [seatId], references: [id], onDelete: Cascade)
  showtime   Showtime @relation(fields: [showtimeId], references: [id], onDelete: Cascade)

  @@unique([showtimeId, seatId])
  @@map("showtime_prices")
}

model Booking {
  id                Int                @id @default(autoincrement())
  userId            Int
  bookingCode       String             @unique
  totalAmount       Decimal            @db.Decimal(12, 2)
  discountAmount    Decimal            @default(0) @db.Decimal(12, 2)
  finalAmount       Decimal            @db.Decimal(12, 2)
  status            BookingStatus      @default(PENDING)
  note              String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  bookingDetails    BookingDetail[]
  bookingPromotions BookingPromotion[]
  user              User               @relation(fields: [userId], references: [id])
  payments          Payment[]
  refundRequests    RefundRequest[]
  tickets           Ticket[]

  @@map("bookings")
}

model BookingDetail {
  id         Int      @id @default(autoincrement())
  bookingId  Int
  showtimeId Int
  seatId     Int
  price      Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seat       Seat     @relation(fields: [seatId], references: [id])
  showtime   Showtime @relation(fields: [showtimeId], references: [id], onDelete: Cascade)

  @@map("booking_details")
}

model SeatHold {
  id         Int        @id @default(autoincrement())
  userId     Int?
  showtimeId Int
  seatId     Int
  holdCode   String     @unique
  status     HoldStatus @default(HOLDING)
  expiresAt  DateTime
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  seat       Seat       @relation(fields: [seatId], references: [id], onDelete: Cascade)
  showtime   Showtime   @relation(fields: [showtimeId], references: [id], onDelete: Cascade)

  @@unique([showtimeId, seatId])
  @@map("seat_holds")
}

model Payment {
  id              Int           @id @default(autoincrement())
  bookingId       Int
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  amount          Decimal       @db.Decimal(12, 2)
  transactionCode String?
  paymentUrl      String?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Ticket {
  id         Int          @id @default(autoincrement())
  bookingId  Int
  showtimeId Int
  seatId     Int
  ticketCode String       @unique
  qrCode     String?
  price      Decimal      @db.Decimal(12, 2)
  status     TicketStatus @default(ACTIVE)
  usedAt     DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  booking    Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seat       Seat         @relation(fields: [seatId], references: [id])
  showtime   Showtime     @relation(fields: [showtimeId], references: [id], onDelete: Cascade)

  @@unique([showtimeId, seatId])
  @@map("tickets")
}

model RefundRequest {
  id           Int          @id @default(autoincrement())
  refundCode   String       @unique
  bookingId    Int         @unique
  userId       Int
  reason       String
  status       RefundStatus @default(PENDING)
  amount       Decimal      @db.Decimal(12, 2)
  requestedAt  DateTime     @default(now())
  reviewedAt   DateTime?
  reviewerId   Int?
  reviewerNote String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  booking      Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  reviewer     User?        @relation("RefundRequestReviewer", fields: [reviewerId], references: [id])
  user         User         @relation("RefundRequestUser", fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([requestedAt])
  @@map("refund_requests")
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, isRead])
  @@map("notifications")
}

model Promotion {
  id                Int                @id @default(autoincrement())
  code              String             @unique
  name              String
  description       String?
  type              PromotionType
  discountPercent   Int?
  discountAmount    Decimal?           @db.Decimal(12, 2)
  minOrderAmount    Decimal?           @db.Decimal(12, 2)
  maxDiscount       Decimal?           @db.Decimal(12, 2)
  quantity          Int
  usedQuantity      Int                @default(0)
  startDate         DateTime
  endDate           DateTime
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  bookingPromotions BookingPromotion[]

  @@map("promotions")
}

model BookingPromotion {
  id             Int       @id @default(autoincrement())
  bookingId      Int
  promotionId    Int
  discountAmount Decimal   @db.Decimal(12, 2)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  booking        Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  promotion      Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@unique([bookingId, promotionId])
  @@map("booking_promotions")
}

model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  movieId   Int
  rating    Int
  comment   String?
  isHidden  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@map("reviews")
}

model Banner {
  id        Int          @id @default(autoincrement())
  title     String
  imageUrl  String
  linkUrl   String?
  position  String?
  sortOrder Int          @default(0)
  status    BannerStatus @default(ACTIVE)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("banners")
}

model News {
  id          Int        @id @default(autoincrement())
  title       String
  slug        String     @unique
  summary     String?
  content     String
  thumbnail   String?
  authorName  String?
  status      NewsStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("news")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  tableName String?
  recordId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum MovieStatus {
  COMING_SOON
  NOW_SHOWING
  ENDED
}

enum RoomStatus {
  ACTIVE
  MAINTENANCE
  CLOSED
}

enum SeatStatus {
  ACTIVE
  BROKEN
  LOCKED
}

enum ShowtimeStatus {
  ACTIVE
  CANCELLED
  FINISHED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum HoldStatus {
  HOLDING
  EXPIRED
  RELEASED
  BOOKED
}

enum PaymentMethod {
  CASH
  MOMO
  VNPAY
  ZALOPAY
  BANKING
  CARD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum TicketStatus {
  ACTIVE
  USED
  CANCELLED
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  INFO
  REFUND_APPROVED
  REFUND_REJECTED
}

enum PromotionType {
  PERCENT
  AMOUNT
}

enum BannerStatus {
  ACTIVE
  HIDDEN
}

enum NewsStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}
